<?xml version="1.0" encoding="UTF-8"?>
<!-- Explicit LAN UDP transport for this process tree. No interface whitelist.
     For local simulations the helper selects dds_udp_localhost.xml instead. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>smart_vision_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="smart_vision_udp" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>smart_vision_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
