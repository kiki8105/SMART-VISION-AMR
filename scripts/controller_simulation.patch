+    def test_follow_path_cancel_clears_planner_before_manual_unlock(self):
+        from action_msgs.msg import GoalStatus
+
+        cleared = []
+        def clear_navigation(request, response):
+            cleared.append(True)
+            response.success = True
+            return response
+
+        service = self.server.create_service(
+            Trigger, '/panel_test_cancel_navigation', clear_navigation)
+        self.addCleanup(lambda: self.server.destroy_service(service))
+        self.bridge.cancel_service = '/panel_test_cancel_navigation'
+
+        def execute(handle):
+            end = time.monotonic() + 4
+            while time.monotonic() < end:
+                if handle.is_cancel_requested:
+                    handle.canceled()
+                    return FollowPath.Result()
+                time.sleep(.02)
+            handle.succeed()
+            return FollowPath.Result()
+
+        action = ActionServer(
+            self.server, FollowPath, '/follow_path', execute,
+            callback_group=ReentrantCallbackGroup(),
+            cancel_callback=lambda request: CancelResponse.ACCEPT)
+        self.addCleanup(action.destroy)
+        client = ActionClient(self.node, FollowPath, '/follow_path')
+        self.addCleanup(client.destroy)
+        self.until(client.server_is_ready)
+        sent = client.send_goal_async(FollowPath.Goal())
+        self.until(sent.done)
+        goal = sent.result()
+        self.assertTrue(goal.accepted)
+        result = goal.get_result_async()
+        self.until(lambda: self.bridge.external_active.get('follow_path', False))
+
+        self.bridge.cancel()
+
+        self.assertTrue(self.bridge.busy)
+        self.assertTrue(self.bridge.cancel_service_pending)
+        self.until(lambda: bool(cleared) and result.done())
+        self.assertEqual(result.result().status, GoalStatus.STATUS_CANCELED)
+        self.until(lambda: not self.bridge.busy)
+        self.assertEqual(cleared, [True])
