+class StartupOptionsTests(unittest.TestCase):
+    def test_simulation_time_can_be_selected_independently_of_domain(self):
+        for domain, flag, expected in [
+                (76, '--use-sim-time', True),
+                (64, '--no-use-sim-time', False),
+                (64, None, True), (76, None, False)]:
+            with self.subTest(domain=domain, flag=flag):
+                args = ['cmd_vel_controller.py', '--domain-id', str(domain)]
+                if flag:
+                    args.append(flag)
+                with (patch.dict('os.environ', {'DISPLAY': ':test'}),
+                      patch('sys.argv', args),
+                      patch('cmd_vel_controller.rclpy.init'),
+                      patch('cmd_vel_controller.Node',
+                            side_effect=RuntimeError('capture startup')) as node):
+                    with self.assertRaisesRegex(RuntimeError, 'capture startup'):
+                        main()
+                overrides = node.call_args.kwargs['parameter_overrides']
+                self.assertEqual(overrides[0].name, 'use_sim_time')
+                self.assertEqual(overrides[0].value, expected)
+
+    def test_separate_settings_select_domain_and_vehicle(self):
+        with tempfile.TemporaryDirectory() as directory:
+            filename = directory + '/simulation.ini'
+            settings = domain_settings(filename)
+            settings.setValue('ros/domain_id', 97)
+            settings.setValue('vehicles/domain_97/namespace', '/simulation')
+            settings.sync()
+            with (patch.dict('os.environ', {'DISPLAY': ':test', 'ROS_DOMAIN_ID': '64'}),
+                  patch('sys.argv', ['cmd_vel_controller.py', '--settings-file', filename]),
+                  patch('cmd_vel_controller.rclpy.init') as initialize,
+                  patch('cmd_vel_controller.Node',
+                        side_effect=RuntimeError('capture startup')) as node):
+                with self.assertRaisesRegex(RuntimeError, 'capture startup'):
+                    main()
+                self.assertEqual(os.environ['ROS_DOMAIN_ID'], '97')
+                initialize.assert_called_once()
+                self.assertEqual(node.call_args.kwargs['namespace'], '/simulation')
 
 
